# F5 XC API Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — your environment
F5XC_API_TOKEN=example-api-token
F5XC_API_URL=https://example-tenant.console.ves.volterra.io
F5XC_EMAIL=user@example.com

# Application — replace with your values
F5XC_DOMAINNAME=app.example.com
F5XC_LB_NAME=csd-demo
F5XC_NAMESPACE=example-namespace
F5XC_ROOT_DOMAIN=example.com

# Origin Configuration
# The origin IP is an RFC 5737 documentation placeholder and does not route.
# Replace it with your authorized lab origin IP before running the demo.
F5XC_HC_NAME=csd-hc
F5XC_ORIGIN_IP=198.51.100.10
F5XC_ORIGIN_POOL=csd-origin
F5XC_ORIGIN_PORT=3000

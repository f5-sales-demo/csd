# F5 XC API Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — your environment
XCSH_API_TOKEN=example-api-token
XCSH_API_URL=https://example-tenant.console.ves.volterra.io
XCSH_EMAIL=user@example.com

# Deployment ownership — choose exactly one: api or terraform
# Choose one ownership mode. Never run the API create/update/delete workflow against resources present in Terraform state.
XCSH_CSD_DEPLOYMENT_MODE=api

# Application — replace with your values
# XCSH_LB_NAME is the single unsuffixed HTTPS load balancer name used by either ownership mode.
XCSH_DOMAINNAME=client-side-defense.f5-sales-demo.com
XCSH_LB_NAME=client-side-defense
XCSH_NAMESPACE=client-side-defense
XCSH_ROOT_DOMAIN=f5-sales-demo.com

# Origin Configuration — API mode requires an independently supplied origin.
# Stable application/scenario content marker. The repository reference uses OWASP Juice Shop.
# Non-reference API and Azure scenarios must set their own stable, deployment-specific value.
XCSH_APPLICATION_MARKER="OWASP Juice Shop"
# Optional healthcheck — leave empty to omit it.
XCSH_HC_NAME=
# XCSH_ORIGIN_KIND selects exactly one origin representation: public_name or public_ip.
# For public_name, set XCSH_ORIGIN_HOSTNAME and leave XCSH_ORIGIN_IP empty.
# For public_ip, set XCSH_ORIGIN_IP and leave XCSH_ORIGIN_HOSTNAME empty.
XCSH_ORIGIN_HOSTNAME=origin.example.com
XCSH_ORIGIN_IP=
XCSH_ORIGIN_KIND=public_name
XCSH_ORIGIN_POOL=csd-juice-shop
XCSH_ORIGIN_PORT=80
